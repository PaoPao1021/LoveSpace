/* ═══════════════════════════════════════
   贴纸 TabBar · Sticker Navigation Bar
   气质：小动物贴纸 + 毛玻璃底 + Q弹交互
   ═══════════════════════════════════════ */

.tab-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 999;
  padding: 0 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: transparent;
}

.tab-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.88);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  border-radius: 28rpx 28rpx 0 0;
  padding: 10rpx 8rpx;
  box-shadow:
    0 -4rpx 24rpx rgba(180,160,150,0.06),
    0 -1rpx 0 rgba(255,255,255,0.8);
  border: 1rpx solid rgba(255,255,255,0.6);
  border-bottom: none;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 4rpx;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
}
.tab-item:active {
  transform: scale(0.88);
}

/* 贴纸图标容器 */
.tab-sticker {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx 22rpx 16rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 3rpx 10rpx rgba(180,160,150,0.08);
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  margin-bottom: 4rpx;
}
.tab-item:nth-child(even) .tab-sticker { border-radius: 22rpx 18rpx 20rpx 16rpx; }
.tab-item:nth-child(3) .tab-sticker { border-radius: 16rpx 24rpx 18rpx 22rpx; }

.tab-sticker-emoji {
  font-size: 34rpx;
  line-height: 1;
  position: relative;
  z-index: 1;
}

/* 激活态 · 弹跳 + 呼吸光晕 */
.tab-item.active .tab-sticker {
  transform: scale(1.15);
  box-shadow:
    0 6rpx 18rpx rgba(200,160,160,0.18),
    0 0 0 6rpx rgba(232,208,208,0.08);
}

.sticker-bounce {
  animation: stickerBounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes stickerBounce {
  0%   { transform: scale(1); }
  40%  { transform: scale(1.25); }
  70%  { transform: scale(0.92); }
  100% { transform: scale(1.15); }
}

/* 激活光点 */
.sticker-sparkle {
  position: absolute;
  top: -4rpx; right: -4rpx;
  width: 14rpx; height: 14rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.9), rgba(232,208,208,0.4));
  border-radius: 50%;
  animation: sparklePulse 1.5s ease-in-out infinite;
}
@keyframes sparklePulse {
  0%, 100% { transform: scale(1); opacity: 0.7; }
  50%      { transform: scale(1.6); opacity: 1; }
}

/* 文字 */
.tab-text {
  font-size: 20rpx;
  color: #BFBAB5;
  font-weight: 500;
  transition: color 0.3s;
}
.tab-text.active {
  color: #B89A9A;
  font-weight: 600;
}

/* 贴纸底色（来自全局） */
.sticker-bg-blush  { background: linear-gradient(135deg, #F8EDED, #F5E0E0); }
.sticker-bg-cream  { background: linear-gradient(135deg, #F7F2ED, #F0E8DE); }
.sticker-bg-lavender { background: linear-gradient(135deg, #F0ECF8, #E8E0F4); }
.sticker-bg-peach  { background: linear-gradient(135deg, #FFF5F0, #FFEDE0); }
