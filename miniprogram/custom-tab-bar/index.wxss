.tab-shell { position: fixed; left: 0; right: 0; bottom: 0; z-index: 999; padding: 0 18rpx env(safe-area-inset-bottom); pointer-events: none; }
.tab-bar { height: 112rpx; display: flex; align-items: center; padding: 0 12rpx; border: 1rpx solid rgba(70,45,50,.06); border-bottom: none; border-radius: 34rpx 34rpx 0 0; background: rgba(255,255,255,.94); box-shadow: 0 -10rpx 40rpx rgba(55,35,40,.07); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); pointer-events: auto; }
.tab-item { flex: 1; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #aaa0a2; position: relative; }
.tab-icon-wrap { height: 52rpx; display: flex; align-items: center; justify-content: center; position: relative; }
.tab-icon { font-size: 38rpx; line-height: 1; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
.tab-text { margin-top: 5rpx; font-size: 20rpx; font-weight: 520; letter-spacing: 1rpx; }
.tab-item.active { color: #2d2729; }
.tab-item.active .tab-icon { color: #e85d75; transform: translateY(-2rpx); }
.tab-item.active .tab-text { font-weight: 680; }
.active-dot { position: absolute; right: -12rpx; top: 2rpx; width: 8rpx; height: 8rpx; border-radius: 50%; background: #e85d75; }
.tab-item:active { opacity: .58; }
