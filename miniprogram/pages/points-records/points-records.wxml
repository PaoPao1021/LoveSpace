<bg-layer />
<view class="page">
  <view class="record-list" wx:if="{{list.length > 0}}">
    <view class="record-item" wx:for="{{list}}" wx:key="_id">
      <view class="record-left">
        <text class="record-reason">{{item.reason}}</text>
        <text class="record-note" wx:if="{{item.note}}">{{item.note}}</text>
        <text class="record-time">{{item.timeStr}}</text>
      </view>
      <text class="record-points {{item.amount > 0 ? 'positive' : 'negative'}}">
        {{item.amount > 0 ? '+' : ''}}{{item.amount}}
      </text>
    </view>
  </view>
  <view class="empty" wx:if="{{list.length === 0 && loaded}}">
    <text>还没有积分记录</text>
  </view>
</view>
