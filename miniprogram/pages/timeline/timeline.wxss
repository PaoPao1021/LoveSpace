/* 回忆时间轴 · 拍立得 + 恋爱胶片 */
.page { min-height: 100vh; padding: 0 28rpx; background: var(--color-bg); }

/* 月份 */
.month-divider { text-align: center; padding: 32rpx 0 16rpx; }
.month-text {
  display: inline-block;
  font-size: 24rpx; color: #FFFFFF;
  background: linear-gradient(135deg, #E85D75, #F08A9B);
  padding: 8rpx 32rpx; border-radius: var(--radius-pill);
  letter-spacing: 2rpx;
}

/* 时间轴 */
.timeline-items { position: relative; padding-left: 44rpx; }
.timeline-items::before {
  content: '';
  position: absolute; left: 14rpx; top: 0; bottom: 0;
  width: 2rpx;
  background: linear-gradient(180deg, #ECA8B4 0%, #F6DDE2 50%, rgba(242,212,212,0.15) 100%);
}

.timeline-item { position: relative; padding-bottom: 20rpx; }
.timeline-item:active { opacity: 0.88; }

.timeline-dot {
  position: absolute; left: -36rpx; top: 28rpx;
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: #ECA8B4;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(200,160,160,0.2);
  z-index: 2;
}

.timeline-card {
  background: #FFFFFF;
  border-radius: var(--radius-card);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-polaroid);
}

.timeline-date-row { display: flex; align-items: center; gap: 10rpx; margin-bottom: 8rpx; }
.timeline-date { font-size: 22rpx; color: #A05A67; font-weight: 500; }
.timeline-author {
  font-size: 20rpx; color: var(--color-text-light);
  background: #F7F2ED; padding: 2rpx 12rpx; border-radius: var(--radius-pill);
}

.timeline-title { display: block; font-size: 28rpx; font-weight: 600; color: var(--color-text); margin-bottom: 6rpx; }
.timeline-content {
  display: block; font-size: 26rpx; color: var(--color-text-secondary);
  line-height: 1.7; word-break: break-all;
}

.timeline-images { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 14rpx; }
.timeline-img {
  width: 152rpx; height: 152rpx; border-radius: var(--radius-photo);
  flex-shrink: 0;
}

/* 空状态 */
.empty { text-align: center; padding: 140rpx 0; }
.empty-emoji { display: block; font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.6; }
.empty-text { display: block; font-size: 30rpx; font-weight: 600; color: var(--color-text); margin-bottom: 10rpx; }
.empty-sub { font-size: 24rpx; color: var(--color-text-light); }

.load-more { text-align: center; padding: 32rpx; color: var(--color-text-light); font-size: 26rpx; }

/* FAB */
.fab {
  position: fixed; right: 40rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: linear-gradient(135deg, #E85D75, #F08A9B);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(200,160,160,0.22);
  z-index: 20;
}
.fab:active { transform: scale(0.88); }
.fab-icon { font-size: 40rpx; color: #FFFFFF; font-weight: 300; line-height: 1; }

/* 添加弹窗 */
.add-popup { padding: 32rpx; padding-bottom: 56rpx; }
.popup-title { display: block; font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 28rpx; color: var(--color-text); letter-spacing: 1rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 12rpx; font-weight: 500; }
.form-input { width: 100%; height: 80rpx; background: #F7F5F2; border-radius: var(--radius-card); padding: 0 24rpx; font-size: 28rpx; box-sizing: border-box; }
.form-textarea { width: 100%; min-height: 140rpx; background: #F7F5F2; border-radius: var(--radius-card); padding: 20rpx 24rpx; font-size: 28rpx; box-sizing: border-box; }

.date-picker-btn {
  display: flex; align-items: center; gap: 12rpx; height: 80rpx;
  background: #F7F5F2; border-radius: var(--radius-card); padding: 0 24rpx;
}
.date-picker-icon { font-size: 30rpx; }
.date-picker-text { font-size: 28rpx; color: var(--color-text); }

.image-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.image-cell { position: relative; width: 152rpx; height: 152rpx; border-radius: var(--radius-photo); overflow: hidden; }
.image-thumb { width: 100%; height: 100%; }
.image-remove {
  position: absolute; top: 4rpx; right: 4rpx;
  width: 36rpx; height: 36rpx; background: rgba(0,0,0,0.4);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  color: #FFF; font-size: 20rpx; line-height: 1;
}
.image-add {
  background: #F7F5F2;
  border: 2rpx dashed rgba(200,180,160,0.3);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
}
.image-add-icon { font-size: 46rpx; color: #C8B8A8; font-weight: 300; line-height: 1; }
.image-add-text { font-size: 20rpx; color: var(--color-text-light); }

.btn-save {
  width: 100%; height: 88rpx;
  background: linear-gradient(135deg, #E85D75, #F08A9B);
  color: #FFF; border: none; border-radius: var(--radius-pill);
  font-size: 30rpx; font-weight: 600; letter-spacing: 2rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-button); margin-top: 16rpx;
}
.btn-save::after { border: none; }
.btn-save[disabled] { opacity: 0.5; display: flex; align-items: center; justify-content: center; }
