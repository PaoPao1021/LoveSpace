/* 纪念日详情 */
.page { min-height: 100vh; background: var(--color-bg); padding: 0 28rpx 48rpx; }

.detail-header {
  text-align: center; padding: 56rpx 0 36rpx;
  background: linear-gradient(180deg, #F7F2ED, transparent);
  margin: 0 -28rpx; padding-left: 28rpx; padding-right: 28rpx;
}

.detail-emoji { display: block; font-size: 76rpx; margin-bottom: 16rpx; }
.detail-name { display: block; font-size: 40rpx; font-weight: 700; color: var(--color-text); letter-spacing: 2rpx; }
.detail-date-text { display: block; font-size: 26rpx; color: var(--color-text-light); margin-top: 8rpx; }

.countdown-card {
  display: flex;
  background: #FFFFFF; border-radius: var(--radius-widget);
  padding: 44rpx 32rpx; margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}
.countdown-item { flex: 1; text-align: center; }
.countdown-num { display: block; font-size: 68rpx; font-weight: 800; color: #A05A67; }
.countdown-label { display: block; font-size: 24rpx; color: var(--color-text-light); margin-top: 6rpx; }
.countdown-divider { width: 2rpx; background: #F5F2EF; margin: 0 24rpx; }

.card {
  background: #FFFFFF; border-radius: var(--radius-widget);
  padding: 32rpx; margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}
.card-title { display: block; font-size: 28rpx; font-weight: 700; margin-bottom: 14rpx; }
.note-text { font-size: 28rpx; color: var(--color-text-secondary); line-height: 1.8; }

.actions { display: flex; gap: 20rpx; margin-top: 44rpx; }
.btn-action {
  flex: 1; height: 80rpx;
  background: #FFFFFF; color: var(--color-text-secondary);
  border: 1rpx solid #F0EDEA; border-radius: var(--radius-pill);
  font-size: 28rpx; display: flex; align-items: center; justify-content: center;
}
.btn-action.danger { color: #D4B8B8; border-color: #ECA8B4; }
.btn-action::after { border: none; }
