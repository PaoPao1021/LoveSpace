<view class="fitness-page">
  <view class="fitness-glow"></view>

  <view class="fitness-loading" wx:if="{{loading}}">
    <view class="skeleton hero-skeleton"></view>
    <view class="skeleton block-skeleton"></view>
    <view class="skeleton block-skeleton"></view>
  </view>

  <block wx:elif="{{dashboard}}">
    <view class="fitness-head">
      <view>
        <text class="fitness-kicker">BETTER TOGETHER</text>
        <text class="fitness-title">一起变好</text>
        <text class="fitness-subtitle">奖励坚持，不比较体重</text>
      </view>
      <view class="report-entry" bindtap="goReport"><text>周报</text><text>↗</text></view>
    </view>

    <view class="team-hero">
      <view class="team-meta">
        <view><text class="hero-label">本周共同完成</text><text class="hero-date">{{weekLabel}}</text></view>
        <view class="team-score"><text>{{dashboard.teamProgress}}</text><text class="score-unit">%</text></view>
      </view>
      <view class="hero-track"><view class="hero-progress" style="width: {{dashboard.teamProgress}}%;"></view></view>
      <text class="hero-copy">{{teamCopy}}</text>
      <view class="member-row">
        <view class="member-item">
          <image class="member-avatar" src="{{dashboard.me.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
          <view class="member-copy"><text>{{dashboard.me.name}}</text><text>{{dashboard.myStats.workouts}} 次 · {{dashboard.myStats.calories}} 大卡 · {{dashboard.myStats.progress}}%</text></view>
        </view>
        <view class="member-divider"></view>
        <view class="member-item" wx:if="{{dashboard.partner}}">
          <image class="member-avatar" src="{{dashboard.partner.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
          <view class="member-copy"><text>{{dashboard.partner.name}}</text><text>{{dashboard.partnerStats.workouts}} 次 · {{dashboard.partnerStats.calories}} 大卡 · {{dashboard.partnerStats.progress}}%</text></view>
        </view>
        <view class="member-item awaiting" wx:else><text>等待 TA 加入</text></view>
      </view>
    </view>

    <view class="section-head">
      <view><text class="section-kicker">MY PLAN</text><text class="section-title">我的健康目标</text></view>
      <text class="section-action" bindtap="openGoalEditor">{{dashboard.myGoal.configured ? '调整' : '设置'}}</text>
    </view>
    <view class="goal-card" bindtap="openGoalEditor">
      <view class="goal-badge">{{goalTypeLabel}}</view>
      <view class="goal-main">
        <view class="goal-metric"><text class="goal-value">{{dashboard.myGoal.weeklyWorkouts}}</text><text class="goal-unit">次 / 周运动</text></view>
        <view class="goal-metric"><text class="goal-value">{{dashboard.myGoal.dailySteps}}</text><text class="goal-unit">步 / 日</text></view>
      </view>
      <text class="goal-privacy">体重隐私：{{dashboard.myGoal.privacy === 'shared' ? '双方可见' : dashboard.myGoal.privacy === 'private' ? '仅自己可见' : '仅分享趋势'}}</text>
    </view>

    <view class="section-head today-head">
      <view><text class="section-kicker">TODAY</text><text class="section-title">今天的记录</text></view>
      <view class="partner-status {{dashboard.partnerCheckedIn ? 'done' : ''}}">{{dashboard.partnerCheckedIn ? 'TA 已打卡' : '等待 TA'}}</view>
    </view>
    <view class="checkin-card">
      <view class="workout-title-row">
        <view><text class="form-label">运动记录</text><text class="form-note">每次训练分别记录，更接近真实消耗</text></view>
        <view class="add-workout" bindtap="addWorkout">＋ 添加</view>
      </view>

      <view class="workout-list" wx:if="{{workoutDrafts.length}}">
        <view class="workout-card" wx:for="{{workoutDrafts}}" wx:key="id">
          <view class="workout-card-head">
            <view class="workout-order">{{index + 1}}</view>
            <picker class="workout-picker" mode="selector" range="{{workoutLabels}}" value="{{item.workoutIndex}}" data-index="{{index}}" bindchange="onWorkoutTypeChange">
              <view>{{workoutOptions[item.workoutIndex].label}}⌄</view>
            </picker>
            <text class="remove-workout" data-index="{{index}}" bindtap="removeWorkout">删除</text>
          </view>
          <view class="workout-fields">
            <view class="workout-field time-field">
              <text>开始时间</text>
              <picker mode="time" value="{{item.startTime}}" data-index="{{index}}" bindchange="onWorkoutTimeChange"><view>{{item.startTime || '选择'}}</view></picker>
            </view>
            <view class="workout-field">
              <text>运动时长</text>
              <view><input type="number" value="{{item.minutes}}" data-index="{{index}}" data-field="minutes" bindinput="onWorkoutInput" placeholder="0" /><text>分钟</text></view>
            </view>
            <view class="workout-field">
              <text>消耗热量</text>
              <view><input type="number" value="{{item.calories}}" data-index="{{index}}" data-field="calories" bindinput="onWorkoutInput" placeholder="0" /><text>大卡</text></view>
            </view>
          </view>
        </view>
      </view>
      <view class="rest-day" wx:else bindtap="addWorkout"><text>今天暂未添加运动</text><text>休息也是计划的一部分，也可以点这里添加记录</text></view>
      <button class="save-workouts {{workoutsDirty ? 'dirty' : ''}}" loading="{{saving}}" disabled="{{saving || !workoutsDirty}}" bindtap="saveWorkoutRecords">{{workoutsDirty ? '保存运动记录' : dashboard.todayCheckin ? '运动记录已保存' : '添加后在这里保存'}}</button>

      <view class="form-grid lifestyle-grid">
        <view class="field-card">
          <text class="field-label">今日步数</text>
          <view class="field-input"><input type="number" value="{{checkinForm.steps}}" data-field="steps" bindinput="onCheckinInput" placeholder="0" /><text>步</text></view>
        </view>
        <view class="field-card">
          <text class="field-label">饮水</text>
          <view class="field-input"><input type="number" value="{{checkinForm.water}}" data-field="water" bindinput="onCheckinInput" placeholder="0" /><text>杯</text></view>
        </view>
        <view class="field-card">
          <text class="field-label">昨晚睡眠</text>
          <view class="field-input"><input type="digit" value="{{checkinForm.sleep}}" data-field="sleep" bindinput="onCheckinInput" placeholder="0" /><text>小时</text></view>
        </view>
      </view>
      <view class="weight-row">
        <view><text class="form-label">今日体重</text><text class="form-note">可选，不用于双方排名</text></view>
        <view class="weight-input"><input type="digit" value="{{checkinForm.weight}}" data-field="weight" bindinput="onCheckinInput" placeholder="未记录" /><text>kg</text></view>
      </view>
      <view class="meal-row">
        <view><text class="form-label">今天吃得符合计划</text><text class="form-note">不追求完美，只记录真实</text></view>
        <switch checked="{{checkinForm.healthyMeal}}" color="#5f8f76" bindchange="onHealthyMealChange" />
      </view>
      <button class="save-checkin" loading="{{saving}}" disabled="{{saving}}" bindtap="saveCheckin">{{dashboard.todayCheckin ? '更新今日记录' : '完成今日打卡'}}</button>
    </view>

    <view class="section-head partner-workout-head" wx:if="{{dashboard.partner}}">
      <view><text class="section-kicker">PARTNER TODAY</text><text class="section-title">TA 今天的运动</text></view>
      <text class="partner-total" wx:if="{{dashboard.partnerToday}}">{{dashboard.partnerToday.minutes}} 分钟 · {{dashboard.partnerToday.calories}} 大卡</text>
    </view>
    <view class="partner-workout-card" wx:if="{{dashboard.partner && dashboard.partnerToday && dashboard.partnerToday.workouts.length}}">
      <view class="partner-workout-item" wx:for="{{dashboard.partnerToday.workouts}}" wx:key="id">
        <view><text class="partner-workout-type">{{item.typeLabel}}</text><text class="partner-workout-time">{{item.startTime || '未记录时间'}}</text></view>
        <view><text>{{item.minutes}} 分钟</text><text>{{item.calories}} 大卡</text></view>
      </view>
    </view>
    <view class="partner-workout-empty" wx:elif="{{dashboard.partner}}"><text>{{dashboard.partnerCheckedIn ? 'TA 今天记录了休息日' : 'TA 今天还没有保存运动记录'}}</text><text>保存后双方会在这里同步看到</text></view>

    <view class="section-head nutrition-head">
      <view><text class="section-kicker">TODAY'S FUEL</text><text class="section-title">今日饮食参考</text></view>
      <text class="nutrition-basis" wx:if="{{dashboard.nutritionPlan.ready}}">{{dashboard.nutritionPlan.intensity}}</text>
    </view>
    <view class="nutrition-card" wx:if="{{dashboard.nutritionPlan.ready}}">
      <view class="nutrition-energy">
        <view><text class="energy-value">{{dashboard.nutritionPlan.calories}}</text><text class="energy-unit">大卡 / 日</text></view>
        <text class="energy-copy">{{dashboard.nutritionPlan.summary}}</text>
      </view>
      <view class="bmr-panel {{dashboard.nutritionPlan.bmr.ready ? '' : 'incomplete'}}" bindtap="openGoalEditor">
        <view wx:if="{{dashboard.nutritionPlan.bmr.ready}}"><text class="bmr-label">基础代谢估算</text><text class="bmr-value">{{dashboard.nutritionPlan.bmr.value}}<text> 大卡 / 日</text></text><text class="bmr-note">{{dashboard.nutritionPlan.bmr.note}}</text></view>
        <view wx:else><text class="bmr-label">完成基础代谢计算</text><text class="bmr-note">{{dashboard.nutritionPlan.bmr.message}}</text></view>
        <text class="bmr-action">{{dashboard.nutritionPlan.bmr.ready ? '修改参数' : '补充资料 →'}}</text>
      </view>
      <view class="macro-list">
        <view class="macro-item" wx:for="{{dashboard.nutritionPlan.macros}}" wx:key="key">
          <view class="macro-top"><text>{{item.name}}</text><text>{{item.grams}}g · {{item.ratio}}%</text></view>
          <view class="macro-track"><view style="width: {{item.ratio}}%; background: {{item.color}};"></view></view>
        </view>
      </view>
      <view class="food-title"><text>怎么吃更容易做到</text><text>按食材替换，不必照搬菜单</text></view>
      <view class="food-grid">
        <view class="food-item" wx:for="{{dashboard.nutritionPlan.foodGroups}}" wx:key="key">
          <text class="food-name">{{item.name}}</text><text class="food-list">{{item.foods}}</text><text class="food-note">{{item.note}}</text>
        </view>
      </view>
      <text class="nutrition-disclaimer">{{dashboard.nutritionPlan.disclaimer}}</text>
    </view>
    <view class="nutrition-empty" wx:else bindtap="openGoalEditor">
      <view><text>先补充当前体重</text><text>{{dashboard.nutritionPlan.message}}</text></view><text>去设置 →</text>
    </view>

    <view class="section-head">
      <view><text class="section-kicker">CHALLENGES</text><text class="section-title">双人挑战</text></view>
      <text class="section-action" bindtap="openChallengePicker">发起挑战</text>
    </view>
    <view class="challenge-list" wx:if="{{dashboard.challenges.length}}">
      <view class="challenge-card {{item.status === 'completed' ? 'completed' : ''}}" wx:for="{{dashboard.challenges}}" wx:key="_id">
        <view class="challenge-top">
          <view><text class="challenge-state">{{item.status === 'completed' ? 'COMPLETED' : 'IN PROGRESS'}}</text><text class="challenge-title">{{item.title}}</text></view>
          <text class="challenge-reward">＋{{item.rewardPoints}} 分/人</text>
        </view>
        <view class="challenge-track"><view class="challenge-progress" style="width: {{item.percent}}%;"></view></view>
        <view class="challenge-bottom"><text>{{item.current}} / {{item.target}} {{item.unit}}</text><text>{{item.endDate}} 截止</text></view>
      </view>
    </view>
    <view class="challenge-empty" wx:else bindtap="openChallengePicker">
      <text class="empty-symbol">＋</text><text class="empty-title">开启你们的第一个健康挑战</text><text class="empty-copy">共同进度，不做输赢排名</text>
    </view>

    <view class="health-note">健康记录用于陪伴和趋势观察，不替代医生或营养师建议。</view>
  </block>

  <view class="fitness-empty" wx:else><text>健康模块暂时无法打开</text><text>下拉页面再试一次</text></view>
</view>

<view class="sheet-mask" wx:if="{{showGoalEditor}}" bindtap="closeGoalEditor">
  <view class="sheet-panel" catchtap="stopPropagation">
    <view class="sheet-handle"></view>
    <view class="sheet-title-row"><view><text class="sheet-kicker">MY GOAL</text><text class="sheet-title">设置我的目标</text></view><text class="sheet-close" bindtap="closeGoalEditor">×</text></view>
    <text class="editor-label">当前方向</text>
    <view class="choice-row">
      <view class="choice-chip {{goalForm.goalType === 'fat-loss' ? 'selected' : ''}}" data-value="fat-loss" bindtap="selectGoalType">减脂</view>
      <view class="choice-chip {{goalForm.goalType === 'muscle' ? 'selected' : ''}}" data-value="muscle" bindtap="selectGoalType">增肌</view>
      <view class="choice-chip {{goalForm.goalType === 'shape' ? 'selected' : ''}}" data-value="shape" bindtap="selectGoalType">塑形</view>
    </view>
    <view class="editor-grid">
      <view class="editor-field"><text>当前体重（代谢计算必填）</text><view><input type="digit" value="{{goalForm.currentWeight}}" data-field="currentWeight" bindinput="onGoalInput" placeholder="--" /><text>kg</text></view></view>
      <view class="editor-field"><text>目标体重（可选）</text><view><input type="digit" value="{{goalForm.targetWeight}}" data-field="targetWeight" bindinput="onGoalInput" placeholder="--" /><text>kg</text></view></view>
      <view class="editor-field"><text>每周运动</text><view><input type="number" value="{{goalForm.weeklyWorkouts}}" data-field="weeklyWorkouts" bindinput="onGoalInput" /><text>次</text></view></view>
      <view class="editor-field"><text>每日步数</text><view><input type="number" value="{{goalForm.dailySteps}}" data-field="dailySteps" bindinput="onGoalInput" /><text>步</text></view></view>
    </view>
    <view class="metabolic-head"><text class="editor-label">基础代谢参数</text><text>仅自己可见 · 适用于 18—80 岁成年人</text></view>
    <view class="sex-choice-row">
      <view class="choice-chip {{goalForm.biologicalSex === 'female' ? 'selected' : ''}}" data-value="female" bindtap="selectBiologicalSex">生理女性</view>
      <view class="choice-chip {{goalForm.biologicalSex === 'male' ? 'selected' : ''}}" data-value="male" bindtap="selectBiologicalSex">生理男性</view>
    </view>
    <view class="editor-grid metabolic-grid">
      <view class="editor-field"><text>身高</text><view><input type="digit" value="{{goalForm.height}}" data-field="height" bindinput="onGoalInput" placeholder="--" /><text>cm</text></view></view>
      <view class="editor-field"><text>年龄</text><view><input type="number" value="{{goalForm.age}}" data-field="age" bindinput="onGoalInput" placeholder="--" /><text>岁</text></view></view>
    </view>
    <text class="editor-label privacy-label">体重隐私</text>
    <view class="privacy-list">
      <view class="privacy-item {{goalForm.privacy === 'trend' ? 'selected' : ''}}" data-value="trend" bindtap="selectPrivacy"><view><text>仅分享趋势</text><text>TA 只能看到增减趋势，看不到具体数值</text></view><text>✓</text></view>
      <view class="privacy-item {{goalForm.privacy === 'private' ? 'selected' : ''}}" data-value="private" bindtap="selectPrivacy"><view><text>仅自己可见</text><text>体重和变化都不会展示给 TA</text></view><text>✓</text></view>
      <view class="privacy-item {{goalForm.privacy === 'shared' ? 'selected' : ''}}" data-value="shared" bindtap="selectPrivacy"><view><text>双方可见</text><text>TA 可以看到体重数值和变化</text></view><text>✓</text></view>
    </view>
    <button class="sheet-submit" loading="{{saving}}" disabled="{{saving}}" bindtap="saveGoal">保存目标</button>
  </view>
</view>

<view class="sheet-mask" wx:if="{{showChallengePicker}}" bindtap="closeChallengePicker">
  <view class="sheet-panel challenge-sheet" catchtap="stopPropagation">
    <view class="sheet-handle"></view>
    <view class="sheet-title-row"><view><text class="sheet-kicker">NEW CHALLENGE</text><text class="sheet-title">这周一起完成</text></view><text class="sheet-close" bindtap="closeChallengePicker">×</text></view>
    <view class="preset-card" wx:for="{{dashboard.challengePresets}}" wx:key="id" data-id="{{item.id}}" bindtap="createChallenge">
      <view><text class="preset-title">{{item.title}}</text><text class="preset-note">7 天挑战 · 完成后双方各得 {{item.rewardPoints}} 积分</text></view><text class="preset-arrow">＋</text>
    </view>
  </view>
</view>
