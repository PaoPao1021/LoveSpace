.page { min-height: 100vh; padding: 24rpx 32rpx; background: var(--color-bg); }
.quiz-header { text-align: center; padding: 48rpx 0; }
.quiz-emoji { display: block; font-size: 64rpx; margin-bottom: 12rpx; }
.quiz-title { display: block; font-size: 36rpx; font-weight: 700; }
.quiz-desc { display: block; font-size: 24rpx; color: var(--color-text-secondary); margin-top: 8rpx; }
.quiz-item { background: #FFFFFF; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.quiz-question { display: block; font-size: 28rpx; font-weight: 500; margin-bottom: 16rpx; }
.answer-item { display: block; font-size: 24rpx; color: var(--color-text-secondary); margin-bottom: 4rpx; }
.match-result { display: block; font-size: 24rpx; color: var(--color-success); margin-top: 8rpx; }
.empty { text-align: center; padding: 80rpx 0; }
.empty-emoji { display: block; font-size: 64rpx; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; color: var(--color-text-secondary); }
