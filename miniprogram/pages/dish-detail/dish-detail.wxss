.page { min-height: 100vh; padding: 24rpx 32rpx; background: var(--color-bg); }
.card { background: #FFFFFF; border-radius: 24rpx; padding: 40rpx; margin-bottom: 24rpx; }
.dish-name { display: block; font-size: 40rpx; font-weight: 700; margin-bottom: 16rpx; }
.dish-meta { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.meta-item { font-size: 26rpx; color: var(--color-text-secondary); }
.dish-desc { display: block; font-size: 28rpx; color: var(--color-text); margin-bottom: 12rpx; }
.dish-note { display: block; font-size: 28rpx; line-height: 1.6; margin-bottom: 16rpx; }
.dish-eaten, .dish-location { display: block; font-size: 24rpx; color: var(--color-text-secondary); margin-top: 8rpx; }
.actions { display: flex; gap: 24rpx; }
.btn-action { flex: 1; background: #FFFFFF; border: 2rpx solid var(--color-border); border-radius: 999rpx; font-size: 28rpx; }
.btn-action.danger { color: var(--color-danger); border-color: var(--color-danger); }
.btn-action::after { border: none; }

/* 规格展示 */
.specs-show { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(0,0,0,0.04); }
.specs-title { display: block; font-size: 26rpx; font-weight: 500; margin-bottom: 12rpx; }
.spec-group-show { margin-bottom: 8rpx; }
.spec-group-name { font-size: 24rpx; color: var(--color-text-secondary); }
.spec-opts { font-size: 24rpx; color: var(--color-text); }

/* 编辑弹窗 */
.edit-popup { padding: 32rpx; }
.popup-title { display: block; font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 28rpx; }
.form-item { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 12rpx; }
.form-label-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.form-input { height: 80rpx; background: #F8F8F8; border-radius: 12rpx; padding: 0 24rpx; font-size: 28rpx; }

.cat-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.cat-tag { padding: 12rpx 24rpx; background: #F8F8F8; border-radius: 999rpx; font-size: 24rpx; }
.cat-tag.active { background: var(--color-primary); color: #FFFFFF; }

.rating-row { display: flex; gap: 16rpx; }
.rating-star { font-size: 36rpx; opacity: 0.3; }
.rating-star.active { opacity: 1; }

.add-link { font-size: 26rpx; color: var(--color-primary); }
.add-link.small { font-size: 24rpx; margin-top: 8rpx; display: inline-block; }

.spec-group-editor { background: #F8F8F8; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; }
.spec-group-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.spec-group-input { flex: 1; height: 64rpx; background: #FFF; border-radius: 8rpx; padding: 0 16rpx; font-size: 26rpx; }
.spec-remove { font-size: 24rpx; color: var(--color-danger); }

.spec-option-editor { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.spec-opt-name { flex: 2; height: 56rpx; background: #FFF; border-radius: 8rpx; padding: 0 16rpx; font-size: 24rpx; }
.spec-opt-price { flex: 1; height: 56rpx; background: #FFF; border-radius: 8rpx; padding: 0 16rpx; font-size: 24rpx; }
.spec-opt-remove { font-size: 28rpx; color: var(--color-danger); padding: 0 8rpx; }

.btn-primary {
  background: linear-gradient(135deg, #E8D0D0, #F2D4D4); color: #FFF; border: none;
  border-radius: var(--radius-pill); padding: 24rpx; font-size: 30rpx; font-weight: 600; margin-top: 16rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-button);
}
.btn-primary::after { border: none; }
