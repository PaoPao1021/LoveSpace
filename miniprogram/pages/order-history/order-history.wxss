.page { min-height: 100vh; padding: 24rpx 32rpx; background: var(--color-bg); }

.order-card {
  background: #FFFFFF; border-radius: 20rpx; padding: 24rpx;
  margin-bottom: 16rpx;
}
.order-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx; padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.order-status { font-size: 26rpx; color: var(--color-primary); font-weight: 500; }
.order-time { font-size: 24rpx; color: var(--color-text-secondary); }

.order-items { margin-bottom: 16rpx; }
.order-item { display: flex; align-items: center; gap: 8rpx; padding: 4rpx 0; }
.item-name { font-size: 28rpx; }
.item-spec { font-size: 24rpx; color: var(--color-text-secondary); }
.item-qty { font-size: 24rpx; color: var(--color-text-secondary); margin-left: auto; }

.order-footer {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 16rpx; border-top: 1rpx solid rgba(0,0,0,0.04);
}
.order-count { font-size: 24rpx; color: var(--color-text-secondary); }
.order-total { font-size: 32rpx; font-weight: 600; color: #FF4D4F; }

.empty { text-align: center; padding: 80rpx 0; }
.empty-emoji { display: block; font-size: 64rpx; margin-bottom: 16rpx; }
.empty-text { display: block; font-size: 28rpx; color: var(--color-text-secondary); }
.empty-sub { font-size: 24rpx; color: var(--color-text-light); margin-top: 8rpx; }
