/* 情侣任务 · 奶油卡片 */
.page { min-height: 100vh; padding: 24rpx 28rpx 140rpx; background: var(--color-bg); }

.section-title { padding: 8rpx 0 16rpx; }
.section-text { font-size: 24rpx; color: var(--color-text-light); }

.task-list { display: flex; flex-direction: column; gap: 14rpx; }

.task-item {
  display: flex; align-items: flex-start; gap: 18rpx;
  background: #FFFFFF; border-radius: var(--radius-card);
  padding: 26rpx 28rpx;
  box-shadow: var(--shadow-card);
  transition: all 0.2s;
}
.task-item:active { background: #FBFAF8; }
.task-item.done { opacity: 0.45; background: #F8F5F2; }

.task-status-icon { font-size: 38rpx; padding-top: 2rpx; flex-shrink: 0; }
.task-info { flex: 1; min-width: 0; }

.task-title-row { display: flex; align-items: center; gap: 10rpx; margin-bottom: 4rpx; }
.task-title { font-size: 28rpx; font-weight: 600; color: var(--color-text); }
.task-assignee { flex-shrink: 0; }

.assignee-tag {
  font-size: 20rpx; padding: 4rpx 14rpx; border-radius: var(--radius-pill);
}
.tag-me { background: #F0ECF6; color: #7C7A9A; }
.tag-ta { background: #F8EDED; color: #A05A67; }
.tag-both { background: #F7F2ED; color: #8A7A6A; }

.task-desc {
  display: block; font-size: 24rpx; color: var(--color-text-light);
  margin-top: 4rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.task-meta { display: flex; align-items: center; gap: 14rpx; margin-top: 8rpx; }
.task-reward { font-size: 22rpx; color: #A05A67; font-weight: 600; }
.task-time { font-size: 20rpx; color: var(--color-text-light); }

/* 空状态 */
.empty { text-align: center; padding: 140rpx 0; }
.empty-emoji { display: block; font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.6; }
.empty-text { display: block; font-size: 30rpx; font-weight: 600; color: var(--color-text); margin-bottom: 10rpx; }
.empty-sub { font-size: 24rpx; color: var(--color-text-light); }

/* FAB */
.fab {
  position: fixed; right: 40rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: linear-gradient(135deg, #E85D75, #F08A9B);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(200,160,160,0.22);
  z-index: 20;
}
.fab:active { transform: scale(0.88); }
.fab-icon { font-size: 40rpx; color: #FFFFFF; font-weight: 300; }

/* 添加弹窗 */
.add-popup { padding: 32rpx; padding-bottom: 56rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 12rpx; font-weight: 500; }
.form-input { width: 100%; height: 80rpx; background: #F7F5F2; border-radius: var(--radius-card); padding: 0 24rpx; font-size: 28rpx; box-sizing: border-box; }
.form-input-short { width: 160rpx; }
.form-textarea { width: 100%; min-height: 100rpx; background: #F7F5F2; border-radius: var(--radius-card); padding: 20rpx 24rpx; font-size: 28rpx; box-sizing: border-box; }

.points-input-row { display: flex; align-items: center; gap: 12rpx; }
.points-unit { font-size: 26rpx; color: var(--color-text-light); }

.assignee-row { display: flex; gap: 14rpx; }
.assignee-option {
  flex: 1; text-align: center; padding: 20rpx;
  background: #F7F2ED; border-radius: var(--radius-card);
  border: 2rpx solid transparent; transition: all 0.2s;
}
.assignee-option.active {
  border-color: #ECA8B4;
  background: rgba(232,93,117,0.12);
}
.assignee-icon { display: block; font-size: 34rpx; margin-bottom: 4rpx; }
.assignee-label { font-size: 24rpx; color: var(--color-text-secondary); }

.btn-save {
  width: 100%; height: 88rpx;
  background: linear-gradient(135deg, #E85D75, #F08A9B);
  color: #FFF; border: none; border-radius: var(--radius-pill);
  font-size: 30rpx; font-weight: 600; letter-spacing: 2rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-button); margin-top: 8rpx;
}
.btn-save::after { border: none; }
.btn-save[disabled] { opacity: 0.5; }

/* 详情弹窗 */
.detail-popup { padding: 32rpx; padding-bottom: 56rpx; }
.detail-status { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin-bottom: 20rpx; padding: 16rpx; border-radius: var(--radius-card); }
.status-done { background: #EEF2EB; }
.status-pending { background: #F7F2ED; }
.detail-status-icon { font-size: 30rpx; }
.detail-status-text { font-size: 26rpx; font-weight: 600; color: var(--color-text); }

.detail-title { display: block; font-size: 34rpx; font-weight: 700; color: var(--color-text); text-align: center; margin-bottom: 20rpx; letter-spacing: 1rpx; }
.detail-desc { background: #F7F2ED; border-radius: var(--radius-card); padding: 20rpx 24rpx; margin-bottom: 20rpx; }
.detail-label { display: block; font-size: 22rpx; color: var(--color-text-light); margin-bottom: 8rpx; }
.detail-value { display: block; font-size: 28rpx; color: var(--color-text); line-height: 1.6; }

.detail-info-grid { display: flex; flex-wrap: wrap; margin-bottom: 24rpx; }
.detail-info-item { width: 50%; padding: 16rpx 0; }
.detail-info-item:nth-child(odd) { border-right: 1rpx solid #F5F2EF; }
.info-label { display: block; font-size: 22rpx; color: var(--color-text-light); margin-bottom: 6rpx; }
.info-value { font-size: 26rpx; color: var(--color-text); font-weight: 500; }
.info-value.points { color: #A05A67; font-weight: 700; }

.detail-actions { display: flex; flex-direction: column; gap: 14rpx; }
.btn-complete {
  width: 100%; height: 88rpx;
  background: linear-gradient(135deg, #E85D75, #F08A9B);
  color: #FFF; border: none; border-radius: var(--radius-pill);
  font-size: 28rpx; font-weight: 600; letter-spacing: 1rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-button);
}
.btn-complete::after { border: none; }
.btn-delete {
  width: 100%; height: 80rpx;
  background: #FFF; color: var(--color-text-light);
  border: 1rpx solid #F0EDEA; border-radius: var(--radius-pill);
  font-size: 26rpx;
  display: flex; align-items: center; justify-content: center;
}
.btn-delete::after { border: none; }
