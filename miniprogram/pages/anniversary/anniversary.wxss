/* 纪念日 · 恋爱胶片风格 */
.page { min-height: 100vh; padding: 24rpx 28rpx 140rpx; background: var(--color-bg); }

.ann-list { display: flex; flex-direction: column; gap: 16rpx; }

.ann-card {
  display: flex; align-items: center; gap: 22rpx;
  background: #FFFFFF; border-radius: var(--radius-widget);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-card);
  transition: all 0.2s;
}
.ann-card:active { background: #FBFAF8; }
.ann-card.is-top { border-left: 4rpx solid #ECA8B4; }

.ann-cover {
  width: 88rpx; height: 100rpx;
  background: linear-gradient(135deg, #F7F2ED, #F0E8DE);
  border-radius: var(--radius-photo);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; flex-shrink: 0;
  box-shadow: var(--shadow-polaroid);
}

.ann-body { flex: 1; min-width: 0; }
.ann-name { display: block; font-size: 28rpx; font-weight: 600; color: var(--color-text); }
.ann-date { display: block; font-size: 22rpx; color: var(--color-text-light); margin-top: 4rpx; }
.ann-note { display: block; font-size: 22rpx; color: var(--color-text-light); margin-top: 2rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.ann-badge { text-align: center; flex-shrink: 0; }
.ann-countdown {
  display: block; font-size: 36rpx; font-weight: 800;
  color: #A05A67; line-height: 1.1;
}
.ann-countdown-label {
  display: block; font-size: 20rpx; color: var(--color-text-light);
}

/* 空状态 */
.empty { text-align: center; padding: 140rpx 0; }
.empty-emoji { display: block; font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.6; }
.empty-text { display: block; font-size: 30rpx; font-weight: 600; color: var(--color-text); margin-bottom: 10rpx; }
.empty-sub { font-size: 24rpx; color: var(--color-text-light); }

/* FAB */
.fab {
  position: fixed; right: 40rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: linear-gradient(135deg, #E85D75, #F08A9B);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(200,160,160,0.22);
  z-index: 20;
}
.fab:active { transform: scale(0.88); }
.fab-icon { font-size: 40rpx; color: #FFFFFF; font-weight: 300; }

/* 弹窗 */
.add-popup { padding: 32rpx; padding-bottom: 56rpx; }
.popup-title { display: block; font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 28rpx; letter-spacing: 1rpx; }
.form-group { margin-bottom: 24rpx; }
.form-label { display: block; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 12rpx; font-weight: 500; }

.form-input { width: 100%; height: 80rpx; background: #F7F5F2; border-radius: var(--radius-card); padding: 0 24rpx; font-size: 28rpx; box-sizing: border-box; }
.form-textarea { width: 100%; min-height: 110rpx; background: #F7F5F2; border-radius: var(--radius-card); padding: 20rpx 24rpx; font-size: 28rpx; box-sizing: border-box; }

.type-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.type-option {
  padding: 16rpx 24rpx; background: #F7F5F2; border-radius: var(--radius-card);
  font-size: 24rpx; color: var(--color-text-secondary);
  border: 2rpx solid transparent; transition: all 0.2s;
}
.type-option.active { border-color: #ECA8B4; background: rgba(232,93,117,0.1); color: #A05A67; }

.date-picker { display: flex; align-items: center; gap: 12rpx; height: 80rpx; background: #F7F5F2; border-radius: var(--radius-card); padding: 0 24rpx; }
.date-picker-icon { font-size: 30rpx; }
.date-picker-text { font-size: 28rpx; color: var(--color-text); }

.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-between .form-label { margin-bottom: 0; }

.btn-save {
  width: 100%; height: 88rpx;
  background: linear-gradient(135deg, #E85D75, #F08A9B);
  color: #FFF; border: none; border-radius: var(--radius-pill);
  font-size: 30rpx; font-weight: 600; letter-spacing: 2rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-button); margin-top: 8rpx;
}
.btn-save::after { border: none; }
