/* 相册详情 */
.page { min-height: 100vh; padding: 16rpx 28rpx 140rpx; background: var(--color-bg); }

.photo-grid { display: flex; flex-wrap: wrap; gap: 8rpx; }
.photo-item {
  width: calc(33.33% - 6rpx); height: 240rpx;
  border-radius: var(--radius-photo); overflow: hidden; position: relative;
}
.photo-img { width: 100%; height: 100%; }
.photo-fav { position: absolute; top: 8rpx; right: 8rpx; font-size: 28rpx; }

.empty { text-align: center; padding: 140rpx 0; }
.empty-emoji { display: block; font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.6; }
.empty-text { display: block; font-size: 30rpx; font-weight: 600; color: var(--color-text); margin-bottom: 10rpx; }
.empty-sub { font-size: 24rpx; color: var(--color-text-light); }

.load-more { text-align: center; padding: 28rpx; color: var(--color-text-light); font-size: 26rpx; }

.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 24rpx 28rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.95); backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 -2rpx 20rpx rgba(180,160,150,0.06);
}
.btn-upload {
  width: 100%; height: 80rpx;
  background: linear-gradient(135deg, #E85D75, #F08A9B);
  color: #FFF; border: none; border-radius: var(--radius-pill);
  font-size: 28rpx; display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-button);
}
.btn-upload::after { border: none; }
