/* 点餐模式 · 美食杂志 */
.order-page { display: flex; flex-direction: column; height: 100vh; background: var(--color-bg); }

.order-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 28rpx; background: #FFFFFF;
  border-bottom: 1rpx solid #F5F2EF;
}
.order-title { font-size: 34rpx; font-weight: 700; color: var(--color-text); }
.order-history-link {
  font-size: 24rpx; color: #B89A9A;
  padding: 8rpx 22rpx; background: #F8EDED;
  border-radius: var(--radius-pill);
}

.order-body { display: flex; flex: 1; overflow: hidden; }

.category-sidebar { width: 170rpx; background: #F7F5F2; flex-shrink: 0; }
.sidebar-item {
  padding: 26rpx 14rpx; text-align: center;
  border-left: 5rpx solid transparent;
  transition: all 0.2s;
}
.sidebar-item.active { background: #FFFFFF; border-left-color: #E8D0D0; }
.sidebar-icon { display: block; font-size: 34rpx; margin-bottom: 6rpx; }
.sidebar-item.active .sidebar-icon { transform: scale(1.12); }
.sidebar-name { font-size: 22rpx; color: var(--color-text-secondary); }
.sidebar-item.active .sidebar-name { color: #B89A9A; font-weight: 600; }

.dish-panel { flex: 1; padding: 16rpx 20rpx; }
.dish-card {
  display: flex; gap: 18rpx; background: #FFFFFF;
  border-radius: var(--radius-card); padding: 22rpx;
  margin-bottom: 14rpx;
  box-shadow: var(--shadow-card);
}
.dish-img { width: 160rpx; height: 160rpx; border-radius: var(--radius-photo); flex-shrink: 0; }
.dish-img-placeholder {
  width: 160rpx; height: 160rpx; border-radius: var(--radius-photo); flex-shrink: 0;
  background: linear-gradient(135deg, #F7F2ED, #F0E8DE);
  display: flex; align-items: center; justify-content: center; font-size: 56rpx;
}
.dish-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.dish-name { font-size: 28rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dish-desc { font-size: 22rpx; color: var(--color-text-light); margin-top: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.spec-hint {
  font-size: 20rpx; color: #B89A9A;
  background: #F8EDED; border: 1rpx solid rgba(200,160,160,0.2);
  padding: 4rpx 12rpx; border-radius: 8rpx;
  display: inline-block; margin-top: 6rpx;
}
.dish-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 6rpx; }
.dish-price { font-size: 30rpx; font-weight: 700; color: #B89A9A; }
.dish-price.no-price { font-size: 22rpx; color: var(--color-text-light); font-weight: 400; }
.dish-add-btn {
  width: 52rpx; height: 52rpx;
  background: linear-gradient(135deg, #E8D0D0, #F2D4D4);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  color: #FFF; font-size: 34rpx; line-height: 1;
  box-shadow: var(--shadow-button);
}

/* 购物车栏 */
.cart-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; gap: 16rpx;
  background: #3C3C3C;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-widget) var(--radius-widget) 0 0;
  z-index: 100;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.08);
}
.cart-icon-wrap { position: relative; }
.cart-icon { font-size: 48rpx; }
.cart-badge {
  position: absolute; top: -10rpx; right: -14rpx;
  background: #E8D0D0; color: #FFF;
  font-size: 20rpx; min-width: 30rpx; height: 30rpx;
  border-radius: var(--radius-pill); text-align: center; line-height: 30rpx;
  padding: 0 8rpx; font-weight: 600;
}
.cart-info { flex: 1; }
.cart-total { display: block; font-size: 34rpx; font-weight: 700; color: #FFF; }
.cart-hint { font-size: 22rpx; color: rgba(255,255,255,0.45); }
.cart-submit {
  background: linear-gradient(135deg, #E8D0D0, #F2D4D4);
  color: #FFF; border: none; border-radius: var(--radius-pill);
  padding: 18rpx 40rpx; font-size: 28rpx; font-weight: 600;
  box-shadow: var(--shadow-button);
}
.cart-submit::after { border: none; }

/* 购物车弹窗 */
.cart-popup { padding: 28rpx 32rpx; max-height: 55vh; }
.cart-popup-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.cart-clear { font-size: 24rpx; color: var(--color-text-light); padding: 6rpx 16rpx; }
.cart-item { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #F5F2EF; }
.cart-item-info { flex: 1; }
.cart-item-name { font-size: 28rpx; font-weight: 500; }
.cart-item-spec { display: block; font-size: 22rpx; color: var(--color-text-light); margin-top: 4rpx; }
.cart-item-right { display: flex; align-items: center; gap: 18rpx; }
.cart-item-price { font-size: 26rpx; font-weight: 700; color: #B89A9A; }

/* 规格弹窗 */
.spec-popup { padding: 32rpx; }
.spec-header { margin-bottom: 24rpx; }
.spec-info { display: flex; align-items: baseline; gap: 14rpx; }
.spec-name { font-size: 34rpx; font-weight: 700; }
.spec-price { font-size: 30rpx; color: #B89A9A; font-weight: 700; }
.spec-group { margin-bottom: 24rpx; }
.spec-group-name { display: block; font-size: 24rpx; color: var(--color-text-light); margin-bottom: 12rpx; }
.spec-options { display: flex; flex-wrap: wrap; gap: 12rpx; }
.spec-option {
  padding: 14rpx 26rpx; background: #F7F5F2; border-radius: var(--radius-card);
  font-size: 26rpx; border: 2rpx solid transparent; display: flex; align-items: center; gap: 8rpx;
  transition: all 0.2s;
}
.spec-option.active { border-color: #E8D0D0; background: rgba(232,208,208,0.08); color: #B89A9A; font-weight: 500; }
.spec-add { font-size: 22rpx; color: #B89A9A; }
.spec-quantity { display: flex; align-items: center; justify-content: space-between; margin: 24rpx 0; }
.btn-primary {
  width: 100%; height: 80rpx;
  background: linear-gradient(135deg, #E8D0D0, #F2D4D4);
  color: #FFF; border: none; border-radius: var(--radius-pill);
  font-size: 30rpx; font-weight: 600; letter-spacing: 1rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--shadow-button);
}
.btn-primary::after { border: none; }

.empty { text-align: center; padding: 120rpx 0; }
.empty-text { font-size: 28rpx; color: var(--color-text-light); }
