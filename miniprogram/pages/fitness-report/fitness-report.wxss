.weekly-page { min-height: 100vh; box-sizing: border-box; padding: 32rpx 28rpx calc(64rpx + env(safe-area-inset-bottom)); color: #29342e; background: #f4f6f2; position: relative; overflow: hidden; }
.weekly-glow { position: absolute; width: 620rpx; height: 620rpx; right: -320rpx; top: -260rpx; border-radius: 50%; background: radial-gradient(circle, rgba(108,150,126,.18), rgba(108,150,126,0) 69%); pointer-events: none; }
.weekly-head { display: flex; align-items: flex-end; justify-content: space-between; padding: 18rpx 4rpx 30rpx; position: relative; z-index: 1; }
.weekly-kicker, .section-kicker { display: block; color: #698471; font-size: 18rpx; font-weight: 750; letter-spacing: 3rpx; }
.weekly-title { display: block; margin-top: 8rpx; font-size: 42rpx; font-weight: 750; }
.week-picker { padding: 14rpx 19rpx; border-radius: 999rpx; color: #567462; background: #fff; box-shadow: 0 5rpx 18rpx rgba(45,70,55,.05); font-size: 22rpx; }
.weekly-hero { display: flex; align-items: center; gap: 30rpx; padding: 34rpx; border-radius: 36rpx; color: #fff; background: linear-gradient(145deg, #365142, #263a30); box-shadow: 0 20rpx 50rpx rgba(45,75,58,.15); }
.score-ring { width: 186rpx; height: 186rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
.score-core { width: 146rpx; height: 146rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; background: #2e4639; }
.score-number { font-size: 58rpx; line-height: 1; font-weight: 760; }
.score-label { margin-top: 8rpx; color: rgba(255,255,255,.5); font-size: 18rpx; }
.hero-copy { min-width: 0; }
.hero-date { display: block; color: #a8c8b3; font-size: 19rpx; letter-spacing: 1rpx; }
.hero-title { display: block; margin-top: 12rpx; font-size: 29rpx; line-height: 1.45; font-weight: 680; }
.hero-note { display: block; margin-top: 13rpx; color: rgba(255,255,255,.45); font-size: 18rpx; }
.report-section { margin-top: 48rpx; }
.section-title { display: block; margin-top: 7rpx; font-size: 33rpx; font-weight: 720; }
.metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-top: 21rpx; }
.metric-card { min-height: 180rpx; box-sizing: border-box; padding: 25rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(45,70,55,.04); }
.metric-card.accent { background: #e6efe8; }
.metric-value { display: block; color: #314038; font-size: 54rpx; line-height: 1.2; font-weight: 750; }
.metric-value.small { padding-top: 8rpx; font-size: 38rpx; }
.metric-label { display: block; margin-top: 13rpx; color: #929d96; font-size: 20rpx; }
.habit-card { display: flex; align-items: center; padding: 27rpx; margin-top: 17rpx; border-radius: 27rpx; background: #f0eadf; }
.habit-mark { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; border-radius: 50%; color: #fff; background: #9c8967; font-size: 28rpx; }
.habit-label { display: block; color: #9a8c76; font-size: 19rpx; }
.habit-title { display: block; margin-top: 5rpx; color: #50483d; font-size: 27rpx; font-weight: 680; }
.member-card { padding: 28rpx; margin-top: 17rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(45,70,55,.04); }
.member-top { display: flex; align-items: flex-start; justify-content: space-between; }
.member-name { display: block; font-size: 27rpx; font-weight: 690; }
.member-role { display: block; margin-top: 5rpx; color: #a0a9a3; font-size: 18rpx; }
.member-score { color: #60806c; font-size: 38rpx; font-weight: 730; }
.member-track { height: 8rpx; margin-top: 20rpx; border-radius: 999rpx; background: #edf0ec; overflow: hidden; }
.member-track view { height: 100%; min-width: 6rpx; border-radius: inherit; background: #79a188; }
.member-metrics { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 24rpx; }
.member-metrics view { text-align: center; border-right: 1rpx solid #edf0ed; }
.member-metrics view:last-child { border-right: 0; }
.member-metrics text { display: block; color: #3b4941; font-size: 27rpx; font-weight: 670; }
.member-metrics text:last-child { margin-top: 5rpx; color: #a1aaa4; font-size: 16rpx; font-weight: 400; }
.weight-trend { display: flex; align-items: center; justify-content: space-between; margin-top: 23rpx; padding-top: 20rpx; border-top: 1rpx solid #eff1ef; color: #98a29b; font-size: 18rpx; }
.weight-trend text:last-child { color: #68776e; }
.insight-card { padding: 28rpx; margin-top: 18rpx; border-radius: 27rpx; color: #fff; background: #4b6757; }
.insight-label { display: block; color: #b9d0c1; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.insight-copy { display: block; margin-top: 12rpx; font-size: 25rpx; line-height: 1.65; }
.report-ending { margin: 40rpx 26rpx 0; color: #a1aaa4; font-size: 18rpx; line-height: 1.7; text-align: center; }
.back-button { height: 88rpx; display: flex; align-items: center; justify-content: center; margin-top: 24rpx; border: 0; border-radius: 24rpx; color: #496d59; background: #e2ede5; font-size: 24rpx; font-weight: 670; line-height: 1; }
.back-button::after { border: 0; }
.report-loading { padding-top: 24rpx; }
.score-skeleton { height: 255rpx; border-radius: 36rpx; }
.metric-skeleton { height: 390rpx; margin-top: 30rpx; border-radius: 28rpx; }
.report-empty { min-height: 65vh; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #748078; font-size: 26rpx; }
.report-empty text:last-child { margin-top: 9rpx; color: #a1aaa4; font-size: 20rpx; }
