<bg-layer />
<view class="page">
  <view class="thanks-header">
    <text class="thanks-emoji">🙏</text>
    <text class="thanks-title">感谢墙</text>
    <text class="thanks-desc">记录对方做过的温暖小事</text>
  </view>
  <view class="card" wx:for="{{list}}" wx:key="_id">
    <text class="thanks-content">{{item.content}}</text>
    <text class="thanks-time">{{item.timeStr}}</text>
  </view>
  <view class="empty" wx:if="{{list.length === 0 && loaded}}">
    <text>还没有记录，快去夸夸对方吧~</text>
  </view>
  <view class="fab" bindtap="onAdd"><text class="fab-icon">+</text></view>
</view>
