/* 点点滴滴 · 奶油记录 */
.page { min-height: 100vh; padding: 24rpx 28rpx 140rpx; background: var(--color-bg); }

.random-btn {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  background: #FFFFFF; border-radius: var(--radius-pill);
  padding: 18rpx; margin-bottom: 24rpx;
  box-shadow: var(--shadow-card); border: 1rpx solid #F0EDEA;
}
.random-icon { font-size: 30rpx; }
.random-text { font-size: 26rpx; color: var(--color-text-secondary); }

.timeline { position: relative; padding-left: 40rpx; }
.timeline::before {
  content: ''; position: absolute; left: 11rpx; top: 0; bottom: 0;
  width: 2rpx; background: linear-gradient(180deg, #ECA8B4, #F0E8DE);
}
.timeline-item { position: relative; margin-bottom: 28rpx; }
.timeline-item:active { opacity: 0.88; }

.timeline-dot {
  position: absolute; left: -35rpx; top: 24rpx;
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #ECA8B4; border: 3rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(200,160,160,0.2);
}
.timeline-card {
  background: #FFFFFF; border-radius: var(--radius-card);
  padding: 26rpx 28rpx; box-shadow: var(--shadow-card);
}
.timeline-title { display: block; font-size: 30rpx; font-weight: 600; color: var(--color-text); margin-bottom: 6rpx; }
.timeline-content { display: block; font-size: 28rpx; color: var(--color-text-secondary); line-height: 1.7; }

.timeline-images { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 14rpx; }
.timeline-img { width: 152rpx; height: 152rpx; border-radius: var(--radius-photo); }

.timeline-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.timeline-tag {
  font-size: 22rpx; color: #A05A67; background: #F8EDED;
  padding: 4rpx 16rpx; border-radius: var(--radius-pill);
}
.timeline-time { display: block; font-size: 22rpx; color: var(--color-text-light); margin-top: 10rpx; }

.empty { text-align: center; padding: 140rpx 0; }
.empty-emoji { display: block; font-size: 80rpx; margin-bottom: 20rpx; opacity: 0.6; }
.empty-text { display: block; font-size: 30rpx; font-weight: 600; color: var(--color-text); margin-bottom: 10rpx; }
.empty-sub { font-size: 24rpx; color: var(--color-text-light); }

.load-more { text-align: center; padding: 28rpx; color: var(--color-text-light); font-size: 26rpx; }

.fab {
  position: fixed; right: 40rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: linear-gradient(135deg, #E85D75, #F08A9B);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 10rpx 28rpx rgba(200,160,160,0.22);
  z-index: 20;
}
.fab:active { transform: scale(0.88); }
.fab-icon { font-size: 40rpx; color: #FFFFFF; font-weight: 300; }
