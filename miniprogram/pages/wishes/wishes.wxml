<bg-layer />
<view class="page">
  <view class="wish-list" wx:if="{{list.length > 0}}">
    <view class="wish-item {{item.status}}" wx:for="{{list}}" wx:key="_id" bindtap="onToggle" data-id="{{item._id}}" data-status="{{item.status}}">
      <view class="wish-status">
        <text wx:if="{{item.status === 'done'}}">🌟</text>
        <text wx:elif="{{item.status === 'doing'}}">💫</text>
        <text wx:else>⭐</text>
      </view>
      <view class="wish-info">
        <text class="wish-title">{{item.title}}</text>
        <text class="wish-desc" wx:if="{{item.description}}">{{item.description}}</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{list.length === 0 && loaded}}">
    <text class="empty-emoji">🌟</text>
    <text class="empty-text">还没有愿望</text>
    <text class="empty-sub">一起写下想做的事吧~</text>
  </view>
  <view class="add-entry" bindtap="onAdd">
    <text class="add-entry-icon">➕</text>
    <text class="add-entry-text">许个愿望</text>
  </view>
  <van-popup show="{{showAdd}}" position="bottom" round bind:close="onCloseAdd">
    <view class="add-popup">
      <text class="popup-title">许个愿望</text>
      <view class="form-item">
        <input class="form-input" placeholder="想一起做什么？" value="{{form.title}}" bindinput="onInput" data-field="title" />
      </view>
      <view class="form-item">
        <input class="form-input" placeholder="补充说明（可选）" value="{{form.description}}" bindinput="onInput" data-field="description" />
      </view>
      <button class="btn-save" bindtap="onSave">许愿</button>
    </view>
  </van-popup>
</view>
