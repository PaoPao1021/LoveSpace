.home-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 28rpx calc(152rpx + env(safe-area-inset-bottom)); background: #f8f5f3; color: #2d2729; position: relative; overflow: hidden; }
.home-glow { position: absolute; width: 520rpx; height: 520rpx; right: -260rpx; top: -180rpx; border-radius: 50%; background: radial-gradient(circle, rgba(232,93,117,.13), rgba(232,93,117,0) 68%); pointer-events: none; }
.home-header { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 4rpx 28rpx; position: relative; z-index: 1; }
.home-brand { display: block; font: 600 36rpx/1.2 Georgia, serif; letter-spacing: 1rpx; color: #2d2729; }
.home-greeting { display: block; font-size: 22rpx; color: #948a8d; margin-top: 9rpx; }
.header-avatars { display: flex; padding-right: 8rpx; }
.header-avatar { width: 62rpx; height: 62rpx; border-radius: 50%; border: 4rpx solid #f8f5f3; box-shadow: 0 5rpx 15rpx rgba(45,39,41,.1); }
.header-avatar.partner { margin-left: -18rpx; }
.relationship-hero { display: flex; align-items: center; justify-content: space-between; min-height: 250rpx; box-sizing: border-box; padding: 36rpx; border-radius: 38rpx; color: #fff; background: linear-gradient(145deg, #342d30, #211d1f); box-shadow: 0 20rpx 55rpx rgba(45,39,41,.15); position: relative; overflow: hidden; }
.relationship-hero::after { content: ''; position: absolute; right: -20rpx; bottom: -110rpx; width: 280rpx; height: 280rpx; border: 1rpx solid rgba(255,255,255,.08); border-radius: 50%; box-shadow: 0 0 0 40rpx rgba(255,255,255,.025), 0 0 0 80rpx rgba(255,255,255,.018); }
.hero-copy { position: relative; z-index: 1; }
.hero-eyebrow { display: block; color: #eaa5b1; font-size: 22rpx; letter-spacing: 2rpx; }
.days-line { display: flex; align-items: baseline; margin: 10rpx 0 4rpx; }
.days-number { font-size: 88rpx; line-height: 1; font-weight: 760; letter-spacing: -3rpx; }
.days-unit { margin-left: 10rpx; color: rgba(255,255,255,.7); font-size: 26rpx; }
.days-caption { display: block; color: rgba(255,255,255,.48); font-size: 22rpx; }
.hero-heart { width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(255,255,255,.16); border-radius: 50%; color: #ed8294; font-size: 46rpx; position: relative; z-index: 1; }
.notice-card { display: flex; align-items: center; padding: 22rpx 24rpx; margin-top: 16rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 6rpx 24rpx rgba(60,40,45,.04); }
.notice-dot { width: 10rpx; height: 10rpx; flex-shrink: 0; margin-right: 16rpx; border-radius: 50%; background: #e85d75; }
.notice-text { flex: 1; min-width: 0; font-size: 23rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #6a5f62; }
.notice-arrow { color: #b6abad; font-size: 30rpx; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 48rpx 4rpx 20rpx; }
.section-kicker { display: block; margin-bottom: 7rpx; color: #a05a67; font-size: 19rpx; font-weight: 700; letter-spacing: 3rpx; }
.section-title { display: block; font-size: 34rpx; font-weight: 720; color: #2d2729; }
.section-action { padding: 10rpx 0 4rpx 20rpx; color: #8f7f83; font-size: 23rpx; }
.daily-card { padding: 32rpx; border-radius: 32rpx; background: linear-gradient(145deg, #f9e3e7, #f5d9df); box-shadow: 0 12rpx 36rpx rgba(150,72,87,.08); }
.daily-meta { display: flex; align-items: center; justify-content: space-between; }
.daily-category { padding: 9rpx 18rpx; border-radius: 999rpx; color: #914d5a; background: rgba(255,255,255,.58); font-size: 20rpx; font-weight: 650; }
.daily-status { color: #9b6d75; font-size: 22rpx; }
.daily-status.done { color: #5c7b68; }
.daily-question { display: block; min-height: 112rpx; margin: 30rpx 0 28rpx; font-size: 32rpx; line-height: 1.6; font-weight: 670; color: #342b2e; }
.daily-footer { display: flex; align-items: center; justify-content: space-between; }
.answer-progress { display: flex; align-items: center; }
.answer-person { width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.58); color: #a28d91; font-size: 19rpx; }
.answer-person.answered { color: #fff; background: #e85d75; }
.progress-line { width: 42rpx; height: 2rpx; background: rgba(107,68,75,.16); }
.daily-arrow { font-size: 38rpx; color: #7f535b; }
.snapshot-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; margin-top: 18rpx; }
.snapshot-card { min-height: 218rpx; box-sizing: border-box; padding: 26rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(60,40,45,.045); }
.anniversary-snapshot { background: #f1e8db; }
.snapshot-top { display: flex; justify-content: space-between; align-items: center; }
.snapshot-label { color: #796e71; font-size: 22rpx; }
.snapshot-symbol { color: #ad9da0; font-size: 28rpx; }
.mood-pair-compact { display: flex; align-items: center; margin: 24rpx 0 17rpx; font-size: 46rpx; }
.mood-divider { margin: 0 10rpx; color: #ded7d8; font-size: 26rpx; }
.snapshot-caption { display: block; color: #9a8f92; font-size: 21rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.countdown-line { display: flex; align-items: baseline; margin: 14rpx 0 12rpx; }
.countdown-number { color: #3c3436; font-size: 58rpx; line-height: 1; font-weight: 750; }
.countdown-unit { margin-left: 7rpx; color: #817477; font-size: 22rpx; }
.snapshot-empty { display: block; margin: 28rpx 0 18rpx; color: #4d4245; font-size: 30rpx; font-weight: 650; }
.fitness-home-card { margin-top: 18rpx; padding: 28rpx 30rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(145deg, #456351, #30483b); box-shadow: 0 10rpx 32rpx rgba(50,79,61,.12); }
.fitness-home-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.fitness-home-copy { min-width: 0; }
.fitness-home-label { display: flex; align-items: center; gap: 10rpx; color: #b8d0c0; font-size: 19rpx; font-weight: 680; letter-spacing: 1rpx; }
.fitness-home-mark { width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #41604e; background: #b8d0c0; font-size: 18rpx; }
.fitness-home-title { display: block; margin-top: 14rpx; font-size: 28rpx; font-weight: 680; }
.fitness-home-note { display: block; margin-top: 7rpx; color: rgba(255,255,255,.48); font-size: 18rpx; }
.fitness-home-score { flex-shrink: 0; text-align: right; }
.fitness-home-score text { display: block; font-size: 38rpx; font-weight: 720; }
.fitness-home-score text:last-child { margin-top: 4rpx; color: rgba(255,255,255,.44); font-size: 17rpx; font-weight: 400; }
.fitness-home-track { height: 8rpx; margin-top: 24rpx; border-radius: 999rpx; background: rgba(255,255,255,.12); overflow: hidden; }
.fitness-home-track view { height: 100%; min-width: 5rpx; border-radius: inherit; background: #a7c9b2; }
.fitness-home-status { display: flex; align-items: center; margin-top: 16rpx; color: rgba(255,255,255,.42); font-size: 18rpx; }
.fitness-home-status > text.done { color: #c3dacb; }
.fitness-home-status > view { width: 4rpx; height: 4rpx; margin: 0 12rpx; border-radius: 50%; background: rgba(255,255,255,.2); }
.fitness-home-arrow { margin-left: auto; color: #b8d0c0 !important; font-size: 27rpx; }
.energy-card { display: flex; align-items: center; min-height: 170rpx; box-sizing: border-box; margin-top: 18rpx; padding: 28rpx 30rpx 38rpx; border-radius: 28rpx; background: #fff; position: relative; overflow: hidden; box-shadow: 0 8rpx 28rpx rgba(60,40,45,.045); }
.energy-copy { flex: 1; min-width: 0; }
.energy-label { display: block; color: #9a8f92; font-size: 21rpx; }
.energy-title { display: block; margin: 8rpx 0 7rpx; color: #352d30; font-size: 30rpx; font-weight: 700; }
.energy-caption { display: block; color: #a3999b; font-size: 20rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.energy-score { color: #e85d75; font-size: 52rpx; font-weight: 750; }
.energy-percent { font-size: 22rpx; }
.energy-track { position: absolute; left: 30rpx; right: 30rpx; bottom: 22rpx; height: 7rpx; border-radius: 999rpx; background: #f1ebec; overflow: hidden; }
.energy-progress { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #e85d75, #ee9aaa); }
.memory-heading { margin-top: 52rpx; }
.memory-scroll { width: calc(100% + 28rpx); }
.memory-list { display: inline-flex; gap: 18rpx; padding-right: 28rpx; }
.memory-card { width: 260rpx; flex-shrink: 0; padding: 12rpx 12rpx 20rpx; box-sizing: border-box; border-radius: 26rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(60,40,45,.045); }
.memory-image { width: 236rpx; height: 205rpx; border-radius: 19rpx; }
.memory-placeholder { display: flex; align-items: center; justify-content: center; color: #d5a8af; background: #f7e9ec; font: 74rpx/1 Georgia, serif; }
.memory-text { display: block; margin: 17rpx 8rpx 7rpx; color: #41383b; font-size: 24rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.memory-time { display: block; margin: 0 8rpx; color: #aaa0a2; font-size: 19rpx; }
.memory-empty { display: flex; align-items: center; justify-content: space-between; padding: 34rpx 30rpx; border: 1rpx dashed #d7c9cc; border-radius: 28rpx; color: #877a7e; font-size: 24rpx; }
.tools-heading { margin-top: 52rpx; }
.quick-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.quick-item { min-height: 190rpx; box-sizing: border-box; padding: 24rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(60,40,45,.04); }
.quick-icon { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; margin-bottom: 20rpx; font-size: 30rpx; font-weight: 400; color: #54484b; }
.quick-icon.rose { background: #f8dfe4; }.quick-icon.sage { background: #e4ede5; }.quick-icon.sand { background: #efe4d5; }.quick-icon.lilac { background: #eae4f0; }.quick-icon.blue { background: #e1eaf0; }.quick-icon.peach { background: #f4e1d8; }
.quick-label { display: block; color: #3c3336; font-size: 26rpx; font-weight: 680; }
.quick-note { display: block; margin-top: 6rpx; color: #a09698; font-size: 20rpx; }
.welcome-state { min-height: 86vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 52rpx; position: relative; z-index: 1; }
.welcome-monogram { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; border-radius: 38rpx; margin-bottom: 38rpx; background: #2d2729; color: #f1b7c1; font: 600 34rpx/1 Georgia, serif; box-shadow: 0 18rpx 46rpx rgba(45,39,41,.16); }
.welcome-eyebrow { color: #a05a67; font-size: 19rpx; font-weight: 700; letter-spacing: 4rpx; }
.welcome-title { margin: 22rpx 0 18rpx; color: #2d2729; font-size: 48rpx; font-weight: 730; }
.welcome-copy { color: #8f8588; font-size: 25rpx; line-height: 1.8; }
.primary-action { width: 100%; height: 92rpx; line-height: 92rpx; margin-top: 48rpx; border: none; border-radius: 999rpx; color: #fff; background: #e85d75; font-size: 28rpx; font-weight: 650; box-shadow: 0 12rpx 30rpx rgba(232,93,117,.2); }
.primary-action::after { border: none; }
.home-loading { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #f8f5f3; color: #a09698; font-size: 23rpx; }
.loading-brand { color: #2d2729; font: 600 42rpx/1 Georgia, serif; margin-bottom: 32rpx; }
.loading-pulse { width: 96rpx; height: 4rpx; margin-bottom: 28rpx; border-radius: 999rpx; background: #eadfe1; overflow: hidden; }
.loading-pulse view { width: 42rpx; height: 100%; border-radius: 999rpx; background: #e85d75; animation: loadingMove 1.2s ease-in-out infinite alternate; }
@keyframes loadingMove { from { transform: translateX(0); } to { transform: translateX(54rpx); } }
.quick-item:active, .snapshot-card:active, .daily-card:active, .energy-card:active, .memory-card:active { transform: scale(.985); opacity: .9; }
