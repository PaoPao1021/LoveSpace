<bg-layer />
<!-- 浮动粒子 -->
<floating-particles count="10" type="mix" />

<!-- 情绪氛围层 -->
<view class="atmo-layer"></view>

<view class="page" wx:if="{{loaded}}">
  <!-- 未绑定 -->
  <view class="welcome-prompt" wx:if="{{!coupleId}}" bindtap="goLogin">
    <view class="sticker-card spring-in">
      <text class="welcome-emoji">💕</text>
      <text class="welcome-title">欢迎来到 LoveSpace</text>
      <text class="welcome-desc">属于你们两个人的私密空间</text>
      <view class="sticker-btn">✨ 开始你们的故事</view>
    </view>
  </view>

  <block wx:if="{{coupleId}}">
    <!-- ═══ Hero：会呼吸的恋人头像卡片 ═══ -->
    <view class="hero-card breath-card spring-in">
      <!-- 透明胶带装饰 -->
      <view class="tape-piece"></view>

      <text class="hero-greeting">{{greeting}}</text>

      <!-- 贴贴近头像 -->
      <view class="cuddle-avatars">
        <view class="hero-avatar-wrap">
          <image class="hero-avatar" src="{{myAvatar || '/images/default-avatar.png'}}" mode="aspectFill" />
        </view>
        <view class="hero-heart-wrap heartbeat">
          <text class="hero-heart">💕</text>
        </view>
        <view class="hero-avatar-wrap">
          <image class="hero-avatar hero-avatar-partner" src="{{partnerAvatar || '/images/default-avatar.png'}}" mode="aspectFill" />
        </view>
      </view>

      <!-- 天数 -->
      <view class="hero-days">
        <text class="hero-days-label">在一起的第</text>
        <view class="hero-days-row">
          <text class="hero-days-num">{{daysTogether}}</text>
          <text class="hero-days-unit">天</text>
        </view>
        <text class="hero-days-date">从 {{startDate}} 开始</text>
      </view>

      <!-- 手绘波浪线 -->
      <view class="wavy-line"></view>

      <!-- 装饰圆点 -->
      <view class="dot-cluster">
        <view></view><view></view><view></view>
      </view>
    </view>

    <!-- 通知 — 便签风格 -->
    <view class="sticker-note spring-in" wx:for="{{notifications}}" wx:key="_id" bindtap="onNotificationTap" data-item="{{item}}" style="animation-delay: {{index * 0.08}}s;">
      <text class="notif-dot"></text>
      <text class="notif-text">{{item.title}} · {{item.content}}</text>
    </view>

    <!-- ═══ 恋爱电量 · 呼吸光晕 ═══ -->
    <view class="energy-card breath-card animate-glow">
      <view class="energy-header">
        <text class="energy-title">💝 恋爱电量</text>
        <view class="bear-tag">{{energyLevel}}</view>
      </view>
      <view class="energy-bar">
        <view class="energy-fill" style="width: {{loveEnergy}}%;"></view>
      </view>
      <text class="energy-tip">{{energyTip}}</text>
      <!-- 缝线装饰 -->
      <view class="stitch-line"></view>
    </view>

    <!-- ═══ 纪念日 · 拍立得贴纸 ═══ -->
    <view class="countdown-card sticker-card breath-card" wx:if="{{nextAnniversary}}" bindtap="goAnniversary">
      <view class="clip-decor"></view>
      <view class="countdown-polaroid">
        <view class="polaroid-inner float-up">
          <text class="polaroid-emoji">📅</text>
        </view>
      </view>
      <view class="countdown-body">
        <text class="countdown-label journal-label">即将到来</text>
        <text class="countdown-name hand-underline">{{nextAnniversary.name}}</text>
        <text class="countdown-date">{{nextAnniversary.date}}</text>
      </view>
      <view class="countdown-badge heart-sticker">
        <text class="countdown-num" wx:if="{{!nextAnniversary.isToday}}">{{nextAnniversary.daysLeft}}</text>
        <text class="countdown-now" wx:else>今天</text>
        <text class="countdown-unit">天</text>
      </view>
    </view>

    <!-- ═══ 今日心情 · 对称贴纸 ═══ -->
    <view class="mood-card breath-card" bindtap="goMood">
      <view class="mood-header">
        <text class="mood-title">今日心情</text>
        <text class="journal-label">打卡</text>
      </view>
      <view class="mood-pair">
        <view class="mood-slot sticker-peel">
          <text class="mood-emoji twinkle">{{myMood.emoji || '😶'}}</text>
          <text class="mood-owner">我</text>
          <text class="mood-status">{{myMood.label || '还没打卡'}}</text>
        </view>
        <view class="mood-divider"></view>
        <view class="mood-slot sticker-peel">
          <text class="mood-emoji twinkle" style="animation-delay: 1.2s;">{{partnerMood.emoji || '😶'}}</text>
          <text class="mood-owner">TA</text>
          <text class="mood-status">{{partnerMood.label || '还没打卡'}}</text>
        </view>
      </view>
    </view>

    <!-- ═══ 照片回忆 · 拍立得胶带 ═══ -->
    <view class="photo-card breath-card" wx:if="{{recentList.length > 0}}" bindtap="goTimeline">
      <view class="photo-header">
        <text class="photo-title">📸 最近瞬间</text>
        <text class="journal-label">全部</text>
      </view>
      <view class="photo-list">
        <view class="photo-item sticker-peel" wx:for="{{recentList}}" wx:key="_id">
          <image class="photo-thumb" wx:if="{{item.hasImage}}" src="{{item.image}}" mode="aspectFill" />
          <view class="photo-thumb photo-placeholder" wx:else>
            <text>💭</text>
          </view>
          <text class="photo-text">{{item.text}}</text>
          <text class="photo-time date-stamp">{{item.time}}</text>
        </view>
      </view>
    </view>

    <!-- ═══ 今日一句 · 手绘标签 ═══ -->
    <view class="quote-card gentle-sway">
      <text class="quote-mark">"</text>
      <text class="quote-text">{{dailyQuote}}</text>
    </view>

    <!-- ═══ 贴纸导航 ═══ -->
    <view class="sticker-nav">
      <view class="sticker-nav-item spring-in" wx:for="{{navItems}}" wx:key="label" bindtap="{{item.tap}}" style="animation-delay: {{index * 0.06}}s;">
        <view class="sticker-nav-icon {{item.bg}}">
          <text>{{item.emoji}}</text>
        </view>
        <text class="sticker-nav-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 底部呼吸空间 -->
    <view style="height: 80rpx;"></view>
  </block>
</view>

<!-- 加载 -->
<view class="loading-page" wx:if="{{!loaded}}">
  <text class="loading-emoji heartbeat">💕</text>
  <text class="loading-text">加载你们的世界...</text>
</view>
