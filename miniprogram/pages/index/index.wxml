<view class="home-page" wx:if="{{loaded}}">
  <view class="home-glow"></view>

  <view class="welcome-state" wx:if="{{!coupleId}}">
    <view class="welcome-monogram">LS</view>
    <text class="welcome-eyebrow">A PRIVATE SPACE FOR TWO</text>
    <text class="welcome-title">把爱落在每一天</text>
    <text class="welcome-copy">记录、倾听、一起计划。这里只属于你们两个人。</text>
    <button class="primary-action" bindtap="goLogin">创建双人空间</button>
  </view>

  <block wx:else>
    <view class="home-header">
      <view>
        <text class="home-brand">LoveSpace</text>
        <text class="home-greeting">{{greeting}}</text>
      </view>
      <view class="header-avatars">
        <image class="header-avatar" src="{{myAvatar || '/images/default-avatar.png'}}" mode="aspectFill" />
        <image class="header-avatar partner" src="{{partnerAvatar || '/images/default-avatar.png'}}" mode="aspectFill" />
      </view>
    </view>

    <view class="relationship-hero">
      <view class="hero-copy">
        <text class="hero-eyebrow">{{myName}} & {{partnerName}}</text>
        <view class="days-line"><text class="days-number">{{daysTogether}}</text><text class="days-unit">天</text></view>
        <text class="days-caption">从 {{startDate}} 开始，认真相爱</text>
      </view>
      <view class="hero-heart"><text>♥</text></view>
    </view>

    <view class="notice-card" wx:for="{{notifications}}" wx:key="_id" bindtap="onNotificationTap" data-item="{{item}}">
      <view class="notice-dot"></view>
      <text class="notice-text">{{item.title}} · {{item.content}}</text>
      <text class="notice-arrow">›</text>
    </view>

    <view class="section-heading">
      <view><text class="section-kicker">TODAY</text><text class="section-title">今天，靠近一点</text></view>
      <text class="section-action" bindtap="goDailyQuestion">进入问答</text>
    </view>

    <view class="daily-card" bindtap="goDailyQuestion">
      <view class="daily-meta"><text class="daily-category">{{dailyQuestion.category || '每日一问'}}</text><text class="daily-status {{dailyQuestion.myAnswer ? 'done' : ''}}">{{dailyQuestionStatus}}</text></view>
      <text class="daily-question">{{dailyQuestion.question || '留五分钟给彼此，回答今天的问题。'}}</text>
      <view class="daily-footer">
        <view class="answer-progress">
          <view class="answer-person {{dailyQuestion.myAnswer ? 'answered' : ''}}">我</view>
          <view class="progress-line"></view>
          <view class="answer-person {{dailyQuestion.partnerAnswered ? 'answered' : ''}}">TA</view>
        </view>
        <text class="daily-arrow">→</text>
      </view>
    </view>

    <view class="snapshot-grid">
      <view class="snapshot-card" bindtap="goMood">
        <view class="snapshot-top"><text class="snapshot-label">今日心情</text><text class="snapshot-symbol">◌</text></view>
        <view class="mood-pair-compact"><text>{{myMood.emoji || '–'}}</text><text class="mood-divider">/</text><text>{{partnerMood.emoji || '–'}}</text></view>
        <text class="snapshot-caption">{{moodSummary}}</text>
      </view>

      <view class="snapshot-card anniversary-snapshot" bindtap="goAnniversary">
        <view class="snapshot-top"><text class="snapshot-label">下个纪念日</text><text class="snapshot-symbol">◇</text></view>
        <view wx:if="{{nextAnniversary}}"><view class="countdown-line"><text class="countdown-number">{{nextAnniversary.daysLeft}}</text><text class="countdown-unit">天</text></view><text class="snapshot-caption">{{nextAnniversary.name}}</text></view>
        <view wx:else><text class="snapshot-empty">去添加</text><text class="snapshot-caption">记住重要的日子</text></view>
      </view>
    </view>

    <view class="fitness-home-card" bindtap="goFitness">
      <view class="fitness-home-top">
        <view class="fitness-home-copy">
          <view class="fitness-home-label"><text class="fitness-home-mark">↗</text><text>一起变好</text></view>
          <text class="fitness-home-title">本周共同完成 {{fitnessSummary.teamProgress}}%</text>
          <text class="fitness-home-note">{{fitnessCopy}}</text>
        </view>
        <view class="fitness-home-score"><text>{{fitnessSummary.myWorkouts}}</text><text>次运动</text></view>
      </view>
      <view class="fitness-home-track"><view style="width: {{fitnessSummary.teamProgress}}%;"></view></view>
      <view class="fitness-home-status">
        <text class="{{fitnessSummary.checkedIn ? 'done' : ''}}">{{fitnessSummary.checkedIn ? '我已打卡' : '我待打卡'}}</text>
        <view></view>
        <text class="{{fitnessSummary.partnerCheckedIn ? 'done' : ''}}">{{fitnessSummary.partnerCheckedIn ? 'TA 已打卡' : 'TA 待打卡'}}</text>
        <text class="fitness-home-arrow">→</text>
      </view>
    </view>

    <view class="energy-card" bindtap="goMonthlyReport">
      <view class="energy-copy"><text class="energy-label">本期恋爱能量</text><text class="energy-title">{{energyLevel}}</text><text class="energy-caption">{{energyTip}} · 查看关系月报</text></view>
      <view class="energy-score"><text>{{loveEnergy}}</text><text class="energy-percent">%</text></view>
      <view class="energy-track"><view class="energy-progress" style="width: {{loveEnergy}}%;"></view></view>
    </view>

    <view class="section-heading memory-heading">
      <view><text class="section-kicker">MEMORIES</text><text class="section-title">最近的我们</text></view>
      <text class="section-action" bindtap="goTimeline">时间轴</text>
    </view>

    <scroll-view class="memory-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{recentList.length}}">
      <view class="memory-list">
        <view class="memory-card" wx:for="{{recentList}}" wx:key="_id" bindtap="goTimeline">
          <image class="memory-image" wx:if="{{item.hasImage}}" src="{{item.image}}" mode="aspectFill" />
          <view class="memory-image memory-placeholder" wx:else><text>“</text></view>
          <text class="memory-text">{{item.text}}</text>
          <text class="memory-time">{{item.time}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="memory-empty" wx:else bindtap="goMoments"><text>记录第一段共同回忆</text><text>＋</text></view>

    <view class="section-heading tools-heading"><view><text class="section-kicker">TOGETHER</text><text class="section-title">一起去做</text></view></view>
    <view class="quick-grid">
      <view class="quick-item" wx:for="{{quickActions}}" wx:key="label" bindtap="goQuickAction" data-url="{{item.url}}" data-tab="{{item.tab}}">
        <view class="quick-icon {{item.tone}}">{{item.icon}}</view>
        <text class="quick-label">{{item.label}}</text>
        <text class="quick-note">{{item.note}}</text>
      </view>
    </view>
  </block>
</view>

<view class="home-loading" wx:else>
  <view class="loading-brand">LoveSpace</view>
  <view class="loading-pulse"><view></view></view>
  <text>正在打开你们的空间</text>
</view>
