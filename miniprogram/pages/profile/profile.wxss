.profile-page { min-height: 100vh; box-sizing: border-box; padding: 26rpx 28rpx calc(152rpx + env(safe-area-inset-bottom)); background: #f8f5f3; }
.profile-hero { margin: -26rpx -28rpx 0; padding: 58rpx 32rpx 44rpx; text-align: center; background: linear-gradient(180deg, #f4e4e7, #f8f5f3); }
.profile-kicker { display: block; margin-bottom: 28rpx; color: #a05a67; font-size: 19rpx; font-weight: 700; letter-spacing: 4rpx; }
.couple-avatars { display: flex; align-items: center; justify-content: center; }
.avatar-wrap { position: relative; }
.profile-avatar { width: 112rpx; height: 112rpx; border: 5rpx solid rgba(255,255,255,.9); border-radius: 50%; box-shadow: 0 10rpx 28rpx rgba(60,40,45,.09); }
.edit-badge { position: absolute; right: -3rpx; bottom: 2rpx; width: 36rpx; height: 36rpx; display: flex; align-items: center; justify-content: center; border: 3rpx solid #f8f5f3; border-radius: 50%; background: #e85d75; color: #fff; font-size: 22rpx; }
.avatar-connector { display: flex; align-items: center; margin: 0 -4rpx; color: #e85d75; font-size: 25rpx; position: relative; z-index: 1; }
.avatar-connector view { width: 24rpx; height: 2rpx; background: rgba(232,93,117,.26); }
.avatar-connector text { margin: 0 7rpx; }
.profile-names { margin-top: 24rpx; color: #2d2729; font-size: 34rpx; font-weight: 720; }
.profile-names .and { color: #b39fa3; font-family: Georgia, serif; font-weight: 400; }
.profile-days { display: block; margin-top: 9rpx; color: #94898c; font-size: 22rpx; }
.featured-links { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; margin-top: 10rpx; }
.featured-card { min-height: 190rpx; box-sizing: border-box; padding: 26rpx; border-radius: 28rpx; position: relative; overflow: hidden; }
.featured-card.question { color: #fff; background: #2d2729; }
.featured-card.report { color: #3a3033; background: #f0dfc9; }
.featured-kicker { display: block; font-size: 20rpx; opacity: .58; }
.featured-title { display: block; margin-top: 38rpx; font-size: 29rpx; font-weight: 700; }
.featured-arrow { position: absolute; right: 24rpx; bottom: 22rpx; font-size: 32rpx; opacity: .7; }
.group-title { display: block; margin: 42rpx 8rpx 16rpx; color: #8f8386; font-size: 22rpx; font-weight: 650; letter-spacing: 1rpx; }
.profile-menu { overflow: hidden; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(60,40,45,.045); }
.profile-menu-item { display: flex; align-items: center; min-height: 100rpx; padding: 0 24rpx; border-bottom: 1rpx solid #f1ecee; }
.profile-menu-item:last-child { border-bottom: none; }
.menu-symbol { width: 54rpx; height: 54rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 20rpx; border-radius: 17rpx; color: #514548; font-size: 27rpx; }
.menu-symbol.rose { background: #f8dfe4; }.menu-symbol.sand { background: #eee2d2; }.menu-symbol.sage { background: #e2ece4; }.menu-symbol.peach { background: #f4e1d8; }.menu-symbol.lilac { background: #eae4f0; }.menu-symbol.blue { background: #e1eaf0; }.menu-symbol.neutral { background: #eee9ea; }
.menu-label { flex: 1; color: #3b3235; font-size: 27rpx; font-weight: 570; }
.menu-note { margin-right: 14rpx; color: #aaa0a2; font-size: 20rpx; }
.menu-arrow { color: #c0b6b8; font-size: 30rpx; }
.settings-menu { margin-top: 30rpx; }
.profile-menu-item:active, .featured-card:active { opacity: .7; }
.profile-loading { padding-top: 30rpx; }
.profile-skeleton { height: 350rpx; border-radius: 32rpx; }.menu-skeleton { height: 500rpx; margin-top: 28rpx; border-radius: 28rpx; }
.profile-unbound { min-height: 76vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 54rpx; text-align: center; }
.unbound-mark { width: 108rpx; height: 108rpx; display: flex; align-items: center; justify-content: center; border-radius: 34rpx; background: #2d2729; color: #efa7b4; font: 600 32rpx/1 Georgia, serif; }
.unbound-title { margin: 34rpx 0 16rpx; color: #2d2729; font-size: 36rpx; font-weight: 720; }
.unbound-copy { color: #948a8d; font-size: 24rpx; line-height: 1.7; }
.unbound-action { width: 100%; height: 88rpx; line-height: 88rpx; margin-top: 40rpx; border: none; border-radius: 999rpx; background: #e85d75; color: #fff; font-size: 28rpx; font-weight: 650; }.unbound-action::after { border: none; }
.edit-popup { padding: 8rpx 24rpx 40rpx; }.popup-title { display: block; text-align: center; margin-bottom: 28rpx; color: #2d2729; font-size: 34rpx; font-weight: 700; }.form-input { width: 100%; height: 88rpx; box-sizing: border-box; padding: 0 24rpx; margin-bottom: 28rpx; border-radius: 22rpx; background: #f5f1f0; font-size: 29rpx; }.btn-save { width: 100%; height: 88rpx; border: none; border-radius: 999rpx; background: #e85d75; color: #fff; font-size: 29rpx; font-weight: 650; }.btn-save::after { border: none; }
